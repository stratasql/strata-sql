      "hash": "6ee6ee9d2887f",
      "kind": "snapshot",
      "snapshot": {
        "project": {
          "name": "Sales Warehouse",
          "description": "Order-to-cash warehouse",
          "technology": "Databricks",
          "methodology": "ER - 3NF",
          "naming": "catalog.schema.table",
          "stakeholders": [{"name": "Ada Lovelace", "role": "Data Architect", "email": "ada@corp.io"}]
        },
        "catalog:main": {"name": "main"},
        "schema:main.ref": {"name": "ref", "catalog": "main"},
        "schema:main.sales": {"name": "sales", "catalog": "main"},
        "table:main.ref.country": {
          "name": "country",
          "schema": "main.ref",
          "displayName": "Country",
          "description": "ISO country reference list.",
          "columns": ["id", "iso"]
        },
        "column:main.ref.country.id": {"name": "id", "type": "INT", "pk": true},
        "column:main.ref.country.iso": {"name": "iso", "type": "STRING", "unique": true},
        "table:main.sales.customer": {
          "name": "customer",
          "schema": "main.sales",
          "displayName": "Customer",
          "description": "A person or company that buys from us.",
          "columns": ["id", "name", "country_id"]
        },
        "column:main.sales.customer.id": {"name": "id", "type": "BIGINT", "pk": true},
        "column:main.sales.customer.name": {"name": "name", "displayName": "Customer Name", "type": "STRING", "notNull": true},
        "column:main.sales.customer.country_id": {"name": "country_id", "type": "INT"},
        "table:main.sales.customer_orders_mv": {
          "name": "customer_orders_mv",
          "kind": "view",
          "viewType": "materialized",
          "schema": "main.sales",
          "displayName": "Customer Orders (MV)",
          "description": "Order totals per customer, refreshed nightly.",
          "definition": "SELECT customer_id, COUNT(*) AS order_count, SUM(total) AS total_spent\nFROM main.sales.orders\nGROUP BY customer_id",
          "columns": ["customer_id", "order_count", "total_spent"]
        },
        "column:main.sales.customer_orders_mv.customer_id": {"name": "customer_id", "type": "BIGINT"},
        "column:main.sales.customer_orders_mv.order_count": {"name": "order_count", "type": "BIGINT"},
        "column:main.sales.customer_orders_mv.total_spent": {"name": "total_spent", "type": "DECIMAL(18,2)"},
        "table:main.sales.customer_product": {
          "name": "customer_product",
          "schema": "main.sales",
          "displayName": "Customer Product",
          "description": "Bridge table for customers and the products they buy.",
          "columns": ["customer_id", "product_id"]
        },
        "column:main.sales.customer_product.customer_id": {"name": "customer_id", "type": "BIGINT", "pk": true},
        "column:main.sales.customer_product.product_id": {"name": "product_id", "type": "BIGINT", "pk": true},
        "table:main.sales.order_item": {
          "name": "order_item",
          "schema": "main.sales",
          "displayName": "Order Line",
          "description": "One product line on an order.",
          "columns": ["id", "order_id", "product_id"]
        },
        "column:main.sales.order_item.id": {"name": "id", "type": "BIGINT", "pk": true},
        "column:main.sales.order_item.order_id": {"name": "order_id", "type": "BIGINT"},
        "column:main.sales.order_item.product_id": {"name": "product_id", "type": "BIGINT"},
        "table:main.sales.orders": {
          "name": "orders",
          "schema": "main.sales",
          "displayName": "Sales Order",
          "description": "A purchase placed by a customer.",
          "columns": ["id", "customer_id", "total"]
        },
        "column:main.sales.orders.id": {"name": "id", "type": "BIGINT", "pk": true},
        "column:main.sales.orders.customer_id": {"name": "customer_id", "type": "BIGINT", "notNull": true},
        "column:main.sales.orders.total": {"name": "total", "type": "DECIMAL(18,2)", "default": "0"},
        "table:main.sales.product": {
          "name": "product",
          "schema": "main.sales",
          "displayName": "Product",
          "description": "Something we sell.",
          "columns": ["id", "sku"]
        },
        "column:main.sales.product.id": {"name": "id", "type": "BIGINT", "pk": true},
        "column:main.sales.product.sku": {"name": "sku", "type": "STRING", "unique": true},
        "rel:main.ref.country.id>main.sales.customer.country_id": {"parent": "main.ref.country.id", "child": "main.sales.customer.country_id", "cardinality": "1..M"},
        "rel:main.sales.customer.id>main.sales.customer_product.customer_id": {"parent": "main.sales.customer.id", "child": "main.sales.customer_product.customer_id", "cardinality": "1..M"},
        "rel:main.sales.customer.id>main.sales.orders.customer_id": {
          "parent": "main.sales.customer.id",
          "child": "main.sales.orders.customer_id",
          "cardinality": "1..M",
          "name": "places",
          "description": "A customer places many orders; an order belongs to exactly one customer."
        },
        "rel:main.sales.customer>main.sales.product": {
          "parent": "main.sales.customer",
          "child": "main.sales.product",
          "cardinality": "M..M",
          "name": "buys",
          "description": "Customers buy many products and products are bought by many customers.",
          "via": "main.sales.customer_product"
        },
        "rel:main.sales.orders.id>main.sales.order_item.order_id": {"parent": "main.sales.orders.id", "child": "main.sales.order_item.order_id", "cardinality": "1..M"},
        "rel:main.sales.product.id>main.sales.customer_product.product_id": {"parent": "main.sales.product.id", "child": "main.sales.customer_product.product_id", "cardinality": "1..M"},
        "rel:main.sales.product.id>main.sales.order_item.product_id": {"parent": "main.sales.product.id", "child": "main.sales.order_item.product_id", "cardinality": "1..M"}
      }
    },
