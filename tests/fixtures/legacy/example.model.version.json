      "patch": {
        "set": {
          "assign:metric:Active Customers": {"governance": {"owner": "Sales Ops", "lifecycle": "Proposed"}},
          "assign:metric:Average Order Value": {"tags": ["certified"]},
          "assign:metric:Order Count": {"tags": ["certified"], "governance": {"owner": "Sales Ops"}},
          "assign:metric:Sales Amount": {"tags": ["certified"], "governance": {"classification": "Confidential"}}
        },
        "del": []
      }
    }
