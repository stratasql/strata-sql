      "message": "Add the conceptual and logical levels: 4 concepts, 5 entities (Order and Order Line realise the Order concept), their relationships",
      "hash": "a21d42da68990",
      "kind": "delta",
      "patch": {
        "set": {
          "table:main.ref.country": {
            "name": "country",
            "schema": "main.ref",
            "entity": "Country",
            "displayName": "Country",
            "description": "ISO country reference list.",
            "sla": {"exclude": true},
            "columns": ["id", "iso"]
          },
          "table:main.sales.customer": {
            "name": "customer",
            "schema": "main.sales",
            "entity": "Customer",
            "displayName": "Customer",
