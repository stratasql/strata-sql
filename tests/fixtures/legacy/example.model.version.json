    {
      "id": "g2",
      "seq": 5,
      "stream": "governance",
      "ts": "2026-09-24T21:19:21.393Z",
      "user": "Ada Lovelace",
      "email": "ada@corp.io",
      "system": "build-samples",
      "message": "Policies (Data Protection, GDPR, Mask Personal Data, Retention 7 Years, Financial Records, Customer Data) and the tags that bring them",
      "hash": "53d487ae3eb25",
      "kind": "delta",
      "patch": {
        "set": {
          "tag:certified": {
            "name": "certified",
            "displayName": "Certified",
            "description": "Checked and approved for reporting.",
            "owner": "Finance",
            "domain": "Reporting",
            "enabled": true
          },
          "tag:pii": {
            "name": "pii",
            "displayName": "Personal Data",
            "description": "Identifies a natural person",
            "owner": "privacy@corp.io",
            "domain": "Customer",
            "policies": ["GDPR"],
            "enabled": true
          },
          "policy:Customer Data": {
            "name": "Customer Data",
            "parents": ["GDPR", "Retention 7 Years"],
            "type": "business",
            "owner": "Head of Sales",
            "description": "How customer records are collected, used and kept: the personal data rules plus the retention of order history."
          },
          "policy:Data Protection": {
            "name": "Data Protection",
            "type": "security",
            "owner": "Security Office",
            "description": "Personal and confidential data: least-privilege access, and reads are logged."
          },
          "policy:Financial Records": {
            "name": "Financial Records",
            "parents": ["Retention 7 Years"],
            "type": "regulatory",
            "classification": "Confidential",
            "owner": "Finance",
            "description": "Amounts used in financial statements: changes are controlled and reconciled monthly."
          },
          "policy:GDPR": {
            "name": "GDPR",
            "parents": ["Data Protection"],
            "type": "privacy",
            "jurisdiction": "EU",
            "classification": "Restricted",
            "owner": "Privacy Officer",
            "description": "EU General Data Protection Regulation: a lawful basis for processing, data-subject rights, breach notification within 72 hours."
          },
          "policy:Mask Personal Data": {
            "name": "Mask Personal Data",
            "parents": ["GDPR"],
            "type": "protection",
            "owner": "Data Platform",
            "description": "Personal data is masked for everyone outside customer service."
          },
          "policy:Retention 7 Years": {
            "name": "Retention 7 Years",
            "type": "retention",
            "owner": "Finance",
            "description": "Kept for 7 years after the order date, then deleted."
          }
        },
        "del": []
      }
    },
    {
      "id": "g3",
      "seq": 6,
      "stream": "governance",
      "ts": "2026-09-24T21:19:21.394Z",
      "user": "Ada Lovelace",
      "email": "ada@corp.io",
      "system": "build-samples",
      "message": "Governance per level: owners, stewards, classification, criticality and lifecycle; policies on the project, a concept, a schema and a table; masking switched off on the totals view (accepted); owner / steward properties replaced",
      "hash": "f211dc99b78e9",
      "kind": "delta",
      "patch": {
        "set": {
          "assign:project": {
            "governance": {
              "policies": ["Data Protection"],
              "conceptual": {"owner": "Chief Data Officer"},
              "logical": {"owner": "Data Architecture"},
              "physical": {"owner": "Data Platform", "steward": "Data Engineering"},
              "semantic": {"owner": "Finance"}
            }
          },
          "assign:catalog:main": {"governance": {"classification": "Internal"}},
          "assign:schema:main.ref": {"governance": {"classification": "Public"}},
          "assign:schema:main.sales": {"governance": {"owner": "Sales Ops", "steward": "Sales Data Steward", "policies": ["Mask Personal Data"]}},
          "assign:table:main.sales.customer_orders_mv": {"governance": {"off": ["Mask Personal Data"]}},
          "assign:table:main.sales.customer_product": {"governance": {"lifecycle": "Proposed"}},
          "assign:table:main.sales.orders": {"governance": {"criticality": "Critical", "policies": ["Financial Records"]}},
          "assign:column:main.sales.orders.total": {"governance": {"classification": "Confidential"}},
          "assign:concept:Customer": {
            "governance": {
              "owner": "Head of Sales",
              "steward": "Customer Data Steward",
              "classification": "Confidential",
              "criticality": "High",
              "lifecycle": "Active",
              "policies": ["Customer Data"]
            }
          },
          "assign:concept:Order": {"governance": {"owner": "Head of Sales", "criticality": "Critical", "lifecycle": "Active"}},
          "assign:entity:Order": {"governance": {"owner": "Sales Data Architect", "criticality": "Critical"}},
          "acknowledged": ["gov-off:main.sales.customer_orders_mv:Mask Personal Data"],
          "propertyKeys": ["organization_unit"]
        },
        "del": []
      }
    },
    {
      "id": "s1",
      "seq": 7,
      "stream": "semantic",
      "ts": "2026-09-24T21:19:21.395Z",
      "user": "Ada Lovelace",
      "email": "ada@corp.io",
      "system": "build-samples",
      "message": "Add the semantic level: Sales Amount, Order Count, Average Order Value and Active Customers",
      "hash": "27034aaa8b87",
      "kind": "snapshot",
      "snapshot": {
        "metric:Active Customers": {
          "name": "Active Customers",
          "description": "Customers who placed at least one order.",
          "calculation": "orders.customer_id",
          "aggregation": "count_distinct",
          "grain": ["Customer"]
        },
        "metric:Average Order Value": {
          "name": "Average Order Value",
          "description": "What a customer spends on one order on average.",
          "calculation": "{Sales Amount} / {Order Count}",
          "aggregation": "none",
          "grain": ["Order"]
        },
        "metric:Order Count": {
          "name": "Order Count",
          "description": "Number of orders placed.",
          "calculation": "orders.id",
          "aggregation": "count_distinct",
          "grain": ["Order"]
        },
        "metric:Sales Amount": {
          "name": "Sales Amount",
          "description": "Value of the orders placed (order totals).",
          "calculation": "orders.total",
          "aggregation": "sum",
          "grain": ["Order"]
        }
      }
    },
    {
      "id": "g4",
