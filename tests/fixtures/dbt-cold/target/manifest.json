  "model.northwind.report_uk_clients_who_pay_more_than_1000": {
   "resource_type": "model",
   "package_name": "northwind",
   "name": "report_uk_clients_who_pay_more_than_1000",
   "alias": "report_uk_clients_who_pay_more_than_1000",
   "schema": "public_gold",
