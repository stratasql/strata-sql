  "model.northwind.report_receitas_acumuladas": {
   "resource_type": "model",
   "package_name": "northwind",
   "name": "report_receitas_acumuladas",
   "alias": "report_receitas_acumuladas",
   "schema": "public_gold",
   "database": "alphageek",
   "unique_id": "model.northwind.report_receitas_acumuladas",
   "original_file_path": "models/reports/report_receitas_acumuladas.sql",
   "tags": [],
   "description": "",
   "columns": {},
   "meta": {},
   "raw_code": "-- models/view_receitas_acumuladas.sql\r\n\r\n{{ config(\r\n    schema='gold',\r\n    materialized='table'\r\n) }}\r\n\r\nwith receitas_mensais as (\r\n    select\r\n        extract(year from orders.order_date) as ano,\r\n        extract(month from orders.order_date) as mes,\r\n        sum(order_details.unit_price * order_details.quantity * (1.0 - order_details.discount)) as receita_mensal\r\n    from\r\n        {{ ref('stg_orders') }} as orders\r\n    inner join\r\n        {{ ref('stg_order_details') }} as order_details on orders.order_id = order_details.order_id\r\n    group by\r\n        extract(year from orders.order_date),\r\n        extract(month from orders.order_date)\r\n),\r\nreceitas_acumuladas as (\r\n    select\r\n        ano,\r\n        mes,\r\n        receita_mensal,\r\n        sum(receita_mensal) over (partition by ano order by mes) as receita_ytd\r\n    from\r\n        receitas_mensais\r\n)\r\nselect\r\n    ano,\r\n    mes,\r\n    receita_mensal,\r\n    receita_mensal - lag(receita_mensal) over (partition by ano order by mes) as diferenca_mensal,\r\n    receita_ytd,\r\n    (receita_mensal - lag(receita_mensal) over (partition by ano order by mes)) / lag(receita_mensal) over (partition by ano order by mes) * 100 as percentual_mudanca_mensal\r\nfrom\r\n    receitas_acumuladas\r\norder by\r\n    ano, mes",
   "relation_name": "\"alphageek\".\"public_gold\".\"report_receitas_acumuladas\"",
   "constraints": [],
   "group": null,
   "language": "sql",
   "config": {
    "materialized": "table",
    "schema": "gold"
   },
   "depends_on": {
    "nodes": [
     "model.northwind.stg_orders",
     "model.northwind.stg_order_details"
    ]
   }
  },
