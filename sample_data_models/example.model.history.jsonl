{"id":"g2","stream":"governance","ts":"2026-09-24T21:19:21.393Z","hlc":"1790284761393.0000.00f2c1","user":"Ada Lovelace","email":"ada@corp.io","system":"build-samples","message":"Policies (Data Protection, GDPR, Mask Personal Data, Retention 7 Years, Financial Records, Customer Data) and the tags that bring them","kind":"delta","patch":{"set":{"tag:certified":{"name":"certified","displayName":"Certified","description":"Checked and approved for reporting.","owner":"Finance","domain":"Reporting","enabled":true},"tag:pii":{"name":"pii","displayName":"Personal Data","description":"Identifies a natural person","owner":"privacy@corp.io","domain":"Customer","policies":["GDPR"],"enabled":true},"policy:Customer Data":{"name":"Customer Data","parents":["GDPR","Retention 7 Years"],"type":"business","owner":"Head of Sales","description":"How customer records are collected, used and kept: the personal data rules plus the retention of order history."},"policy:Data Protection":{"name":"Data Protection","type":"security","owner":"Security Office","description":"Personal and confidential data: least-privilege access, and reads are logged."},"policy:Financial Records":{"name":"Financial Records","parents":["Retention 7 Years"],"type":"regulatory","classification":"Confidential","owner":"Finance","description":"Amounts used in financial statements: changes are controlled and reconciled monthly."},"policy:GDPR":{"name":"GDPR","parents":["Data Protection"],"type":"privacy","jurisdiction":"EU","classification":"Restricted","owner":"Privacy Officer","description":"EU General Data Protection Regulation: a lawful basis for processing, data-subject rights, breach notification within 72 hours."},"policy:Mask Personal Data":{"name":"Mask Personal Data","parents":["GDPR"],"type":"protection","owner":"Data Platform","description":"Personal data is masked for everyone outside customer service."},"policy:Retention 7 Years":{"name":"Retention 7 Years","type":"retention","owner":"Finance","descripti