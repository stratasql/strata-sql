{
  "strata": 2,
  "project": {
    "name": "Sales Star",
    "description": "A small sales data mart: one fact table at the grain of an order line, with customer, product, date and store dimensions.",
    "technology": "PostgreSQL",
    "methodology": "Dimensional Modelling",
    "naming": "schema.table",
    "governance": {
      "conceptual": {"owner": "Business Sponsor"},
      "logical": {"owner": "Data Architect", "steward": "Data Steward"},
      "physical": {"owner": "Data Engineering", "steward": "Data Steward", "classification": "Internal"},
      "semantic": {"owner": "Analytics"}
    }
  },
  "conceptual": {
    "concepts": [
      {"name": "Customer", "description": "A person or company that buys from us."},
      {"name": "Date", "description": "The day a sale happened."},
      {"name": "Product", "description": "Something we sell."},
      {"name": "Sales", "description": "What we sold: each line of each order."},
      {"name": "Store", "description": "Where a sale happened: a shop or a web channel."}
    ],
    "relationships": [
      {"parent": "Customer", "child": "Sales", "cardinality": "1..M", "name": "buys"},
      {"parent": "Date", "child": "Sales", "cardinality": "1..M", "name": "happens on"},
      {"parent": "Product", "child": "Sales", "cardinality": "1..M", "name": "is sold as"},
      {"parent": "Store", "child": "Sales", "cardinality": "1..M", "name": "happens at"}
    ]
  },
  "logical": {
    "entities": [
      {
        "name": "Customer",
        "concept": "Customer",
        "description": "A person or company that buys from us: one row per customer (type 1: changes overwrite)."
      },
      {
        "name": "Date",
        "concept": "Date",
        "description": "The calendar: one row per day, so reports can group by week, month, quarter and year without date functions."
      },
      {"name": "Product", "concept": "Product", "description": "Something we sell: one row per product."},
      {
        "name": "Sales",
        "concept": "Sales",
        "description": "One order line: quantity and value, tied to a customer, a product, a date and a store."
      },
      {"name": "Store", "concept": "Store", "description": "Where a sale happened: one row per shop or web channel."}
    ],
    "relationships": [
      {"parent": "Customer", "child": "Sales", "cardinality": "1..M", "name": "buys"},
      {"parent": "Date", "child": "Sales", "cardinality": "1..M", "name": "happens on"},
      {"parent": "Product", "child": "Sales", "cardinality": "1..M", "name": "is sold as"},
      {"parent": "Store", "child": "Sales", "cardinality": "1..M", "name": "happens at"}
    ]
  },
  "schemas": [{"name": "dw", "description": "The dimensional model: conformed dimensions and the sales fact."}],
  "tables": [
    {
      "name": "dim_customer",
      "schema": "dw",
      "entity": "Customer",
      "description": "A person or company that buys from us: one row per customer (type 1: changes overwrite).",
      "columns": [
        {
          "name": "customer_key",
          "type": "BIGINT",
          "description": "Surrogate key: meaningless, generated by the warehouse.",
          "pk": true
        },
        {"name": "customer_id", "type": "VARCHAR(30)", "description": "Business key from the order system.", "notNull": true},
        {"name": "customer_name", "type": "VARCHAR(255)", "description": "Full name or company name."},
        {"name": "segment", "type": "VARCHAR(30)", "description": "Consumer, Corporate or Small Business."},
        {"name": "city", "type": "VARCHAR(255)", "description": "City of the billing address."},
        {"name": "country", "type": "VARCHAR(255)", "description": "Country of the billing address."}
      ]
    },
    {
      "name": "dim_date",
      "schema": "dw",
      "entity": "Date",
      "description": "The calendar: one row per day, so reports can group by week, month, quarter and year without date functions.",
      "columns": [
        {"name": "date_key", "type": "INTEGER", "description": "Surrogate key in the form YYYYMMDD.", "pk": true},
        {"name": "full_date", "type": "DATE", "description": "The date.", "notNull": true},
        {"name": "year", "type": "SMALLINT", "description": "Calendar year."},
        {"name": "quarter", "type": "SMALLINT", "description": "Quarter of the year, 1 to 4."},
        {"name": "month", "type": "SMALLINT", "description": "Month number, 1 to 12."},
        {"name": "month_name", "type": "VARCHAR(12)", "description": "January to December."},
        {"name": "day_of_week", "type": "VARCHAR(12)", "description": "Monday to Sunday."},
        {"name": "is_weekend", "type": "BOOLEAN", "description": "True on Saturdays and Sundays."}
      ]
    },
    {
      "name": "dim_product",
      "schema": "dw",
      "entity": "Product",
      "description": "Something we sell: one row per product.",
      "columns": [
        {"name": "product_key", "type": "BIGINT", "description": "Surrogate key.", "pk": true},
        {"name": "product_id", "type": "VARCHAR(30)", "description": "Business key (SKU).", "notNull": true},
        {"name": "product_name", "type": "VARCHAR(255)", "description": "Name shown to customers."},
        {"name": "category", "type": "VARCHAR(60)", "description": "Product category."},
        {"name": "brand", "type": "VARCHAR(60)", "description": "Brand or manufacturer."},
        {"name": "list_price", "type": "DECIMAL(18,2)", "description": "Current list price."}
      ]
    },
    {
      "name": "dim_store",
      "schema": "dw",
      "entity": "Store",
      "description": "Where a sale happened: one row per shop or web channel.",
      "columns": [
        {"name": "store_key", "type": "BIGINT", "description": "Surrogate key.", "pk": true},
        {"name": "store_id", "type": "VARCHAR(30)", "description": "Business key.", "notNull": true},
        {"name": "store_name", "type": "VARCHAR(255)", "description": "Name of the shop or channel."},
        {"name": "city", "type": "VARCHAR(255)", "description": "City."},
        {"name": "region", "type": "VARCHAR(60)", "description": "Sales region."}
      ]
    },
    {
      "name": "fact_sales",
      "schema": "dw",
      "entity": "Sales",
      "description": "Sales: one row per order line (the grain). Measures are additive.",
      "columns": [
        {
          "name": "order_number",
          "type": "VARCHAR(30)",
          "description": "Degenerate dimension: the order this line belongs to.",
          "pk": true
        },
        {"name": "line_number", "type": "SMALLINT", "description": "Line within the order.", "pk": true},
        {"name": "customer_key", "type": "BIGINT", "description": "Who bought.", "notNull": true},
        {"name": "product_key", "type": "BIGINT", "description": "What was sold.", "notNull": true},
        {"name": "date_key", "type": "INTEGER", "description": "When (order date).", "notNull": true},
        {"name": "store_key", "type": "BIGINT", "description": "Where.", "notNull": true},
        {"name": "quantity", "type": "INTEGER", "description": "Units sold."},
        {"name": "unit_price", "type": "DECIMAL(18,2)", "description": "Price of one unit at the time of sale."},
        {"name": "discount_amount", "type": "DECIMAL(18,2)", "description": "Discount on the line."},
        {
          "name": "net_amount",
          "type": "DECIMAL(18,2)",
          "description": "quantity x unit_price - discount_amount: the sales value."
        }
      ]
    }
  ],
  "relationships": [
    {"parent": "dw.dim_customer.customer_key", "child": "dw.fact_sales.customer_key", "cardinality": "1..M"},
    {"parent": "dw.dim_date.date_key", "child": "dw.fact_sales.date_key", "cardinality": "1..M"},
    {"parent": "dw.dim_product.product_key", "child": "dw.fact_sales.product_key", "cardinality": "1..M"},
    {"parent": "dw.dim_store.store_key", "child": "dw.fact_sales.store_key", "cardinality": "1..M"}
  ]
}
